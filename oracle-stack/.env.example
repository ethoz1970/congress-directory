# Copy to .env on the Oracle ( cp .env.example .env ) and fill in real values.
# .env is gitignored — these never leave the Mac mini.

# ============================================================
# DB credentials — match the convention from the BST and
# Eternal Ledger stacks. Either reuse those values (single
# password across all stacks on the Oracle) or rotate per-stack.
# ============================================================
POSTGRES_PASSWORD=change-me
MONGO_PASSWORD=change-me

# ============================================================
# Filter Feeder upstreams — register free, paste here.
# ============================================================
# LegiScan: free tier 30K queries/month, federal + state coverage.
#   https://legiscan.com/legiscan
LEGISCAN_API_KEY=your_legiscan_key_here

# Congress.gov API: free tier 5000 req/hour, federal only,
# but the official US-government source. Useful as a validator
# against LegiScan and for the fromDateTime change-feed.
#   https://api.congress.gov/sign-up
CONGRESS_GOV_API_KEY=your_congress_gov_key_here

# Maryland General Assembly: scraped (no key). Listed here so
# operators see the full source set in one place.
# MGA_BASE_URL=https://mgaleg.maryland.gov

# ============================================================
# Stack identity — useful when this Oracle hosts multiple tenants.
# ============================================================
NODE_ID=whoisourgov
STACK=whoisourgov
