# WhoIsOurGov backend environment variables
# Copy to backend/.env and fill in real values. backend/.env is gitignored.

# ----- Local dev toggle -----
# Set to true to read legislators/committees from local_data/*.json instead of Firestore.
# Useful for running without firebase-credentials.json.
USE_LOCAL_DATA=false

# ----- External APIs -----
# Congress.gov API key — used by the live /sponsored-legislation and /cosponsored-legislation
# proxy endpoints, plus the import_*.py jobs.
CONGRESS_API_KEY=

# ----- The Oracle (Blacksky AI data lake) -----
# Source of Nia-written plain_english + impact_summary, traction scores, portal tags.
# WIOG reads from this server-side; the frontend never calls oracle-api directly.
# Production: https://oracle-api.blacksky-chat.us
# Local fallback / disable: leave ORACLE_API_URL empty and the bill endpoints
# will return 503 cleanly.
ORACLE_API_URL=https://oracle-api.blacksky-chat.us
ORACLE_API_KEY=
