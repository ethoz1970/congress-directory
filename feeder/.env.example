# Copy to .env and paste real values. .env is gitignored — stays on disk only.

# ============================================================
# Filter Feeder API keys.
# ============================================================
# Congress.gov — free key at https://api.congress.gov/sign-up
# Required for the Phase B.1 feeder.
CONGRESS_GOV_API_KEY=your_congress_gov_key_here

# LegiScan — free 30K/month at https://legiscan.com/legiscan
# Optional. Only needed once we wire up state-level coverage (Phase B2).
LEGISCAN_API_KEY=

# ============================================================
# Oracle connection — defaults assume the workstation is on the same
# LAN as the Mac mini at 10.1.10.4. Override per-host as needed.
# ============================================================
# Match the values you put in /Users/blind/whoisourgov/.env on the Oracle.
MONGO_PASSWORD=match-the-oracle-env
POSTGRES_PASSWORD=match-the-oracle-env

# Host/port composition (the simpler form — username 'blacksky' is fixed).
GOV_MONGO_HOST=10.1.10.4
GOV_MONGO_PORT=27019
GOV_POSTGRES_HOST=10.1.10.4
GOV_POSTGRES_PORT=5434

# Or override the entire connection string at once (takes precedence
# over the host/port form). Use this if the Oracle moves behind a proxy
# or you tunnel via SSH.
# GOV_MONGO_URI=mongodb://blacksky:<pw>@10.1.10.4:27019/whoisourgov?authSource=admin
# GOV_POSTGRES_DSN=postgresql://blacksky:<pw>@10.1.10.4:5434/whoisourgov

# ============================================================
# Supabase — Phase D bridge target. Copy these from
# sentiment-vs-power/.env if you've already set them up there.
# Pooler URL for short jobs; DIRECT for the multi-thousand-row backfill.
# ============================================================
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
